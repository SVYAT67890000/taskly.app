PORT=3000
NODE_ENV=production

# SMTP — письма с кодами смены/восстановления пароля
# Без SMTP_HOST коды выводятся в консоль сервера
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=Таскли <noreply@example.com>

# Gmail: smtp.gmail.com, порт 587, пароль приложения (не обычный пароль)
# Yandex: smtp.yandex.ru, порт 465, SMTP_SECURE=true

# Email администраторов через запятую — доступ ко всем обращениям в поддержку
ADMIN_EMAILS=shoroxov07@inbox.ru
