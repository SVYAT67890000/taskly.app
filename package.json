{
  "name": "taskly-app",
  "version": "1.0.0",
  "description": "Таскли — органайзер задач и заметок",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy": "npx wrangler pages deploy",
    "deploy:all": "npx wrangler d1 migrations apply taskly-db --remote && npx wrangler pages deploy",
    "db:migrate:local": "npx wrangler d1 migrations apply taskly-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply taskly-db --remote",
    "dev:pages": "npx wrangler pages dev frontend",
    "preview": "npx wrangler pages dev frontend --binding=DB --d1=taskly-db"
  },
  "keywords": [
    "task",
    "organizer",
    "notes",
    "todo"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express-async-errors": "^3.1.1",
    "hono": "^4.7.4",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "wrangler": "^4.14.0"
  }
}
